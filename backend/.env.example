# ─── Dominion Edge Holdings — AOS Backend ────────────────────────────────────
# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/deh_aos?schema=public"

# ── System User ───────────────────────────────────────────────────────────────
# Auto-seeded on first startup. Set this after running `npm run db:seed`.
SYSTEM_USER_ID=""

# ── Anthropic / AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000"

# ── Apollo.io (lead discovery + enrichment) ───────────────────────────────────
# Get your API key from https://developer.apollo.io/
APOLLO_API_KEY=""

# ── Google Workspace (Gmail + Google Calendar) ────────────────────────────────
# Create an OAuth2 client at https://console.cloud.google.com/apis/credentials
# Required scopes: gmail.send, gmail.readonly, calendar.events, calendar.readonly
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Obtain a refresh token via the OAuth2 playground or your own consent flow:
GOOGLE_REFRESH_TOKEN=""
# Redirect URI registered in your Google Cloud Console:
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
# Calendar to use for event creation (default: primary):
GOOGLE_CALENDAR_ID="primary"
# The "from" address for outbound Gmail:
GMAIL_FROM_EMAIL=""
GMAIL_FROM_NAME="Dominion Edge"

# ── SMTP (alternative email provider) ────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# ── Object Storage (S3-compatible) ───────────────────────────────────────────
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="dominion-edge"
S3_REGION="us-east-1"
# For S3-compatible providers (MinIO, R2, etc.) set a custom endpoint:
# S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="true"  # required for MinIO

# ── Frontend ──────────────────────────────────────────────────────────────────
# In /frontend/.env.local:
# NEXT_PUBLIC_API_URL=http://localhost:3001
