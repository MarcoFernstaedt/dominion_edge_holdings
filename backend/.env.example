# ─── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS — comma-separated list of allowed frontend origins ──────────────────
# SECURITY: Never use wildcard (*) in production.
# Production example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email (backend only — never returned via API) ────────────────────────────
# SMTP credentials are intentionally NOT accepted from API clients.
# Set them here and read in a future EmailService implementation.
# SMTP_PASSWORD=your-smtp-app-password
